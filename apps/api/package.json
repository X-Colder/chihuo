{
  "name": "@chihuo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@chihuo/contracts": "workspace:*",
    "@fastify/jwt": "^9.1.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
