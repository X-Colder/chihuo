<view class="page">
  <view class="page-header">
    <view>
      <text class="eyebrow">CHIHUO / MERCHANT</text>
      <text class="page-title">先看需求，再决定生产</text>
      <text class="page-subtitle">平台把附近消费者的个体要求整理成可执行的批量订单。</text>
    </view>
  </view>

  <view class="summary-row">
    <view class="summary-card">
      <text class="summary-number">{{summary.open}}</text>
      <text class="summary-label">待评估需求</text>
    </view>
    <view class="summary-card">
      <text class="summary-number">{{summary.quoted}}</text>
      <text class="summary-label">我的报价</text>
    </view>
    <view class="summary-card">
      <text class="summary-number">{{summary.ready}}</text>
      <text class="summary-label">可生产需求</text>
    </view>
  </view>

  <view class="toolbar">
    <text class="section-title">匹配需求</text>
    <text class="muted">{{demands.length}} 条</text>
  </view>

  <view wx:if="{{loading}}" class="loading">正在加载需求大厅...</view>
  <view wx:elif="{{error}}" class="error">
    <text>{{error}}</text>
    <button class="secondary-btn retry-btn" bindtap="load">重新加载</button>
  </view>
  <view wx:elif="{{empty}}" class="empty">当前区域还没有适合报价的需求</view>
  <block wx:else>
    <view wx:for="{{demands}}" wx:key="id" class="card demand-card" data-id="{{item.id}}" bindtap="openDemand">
      <view class="card-topline">
        <view>
          <text class="card-title">{{item.title}}</text>
          <text class="muted demand-category">{{item.category}} · {{item.serviceArea}}</text>
        </view>
        <text class="status {{item.statusClass}}">{{item.status}}</text>
      </view>
      <view class="meta-row">
        <text class="meta">{{item.schedule}}</text>
        <text class="meta">预算 {{item.budget}}</text>
      </view>
      <view class="capacity">
        <view>
          <text class="capacity-number">{{item.joined}}</text>
          <text class="muted"> 人已加入</text>
        </view>
        <text class="muted">目标 {{item.target}} 人</text>
      </view>
      <view class="tag-row">
        <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
      <view class="card-footer">
        <text class="muted">{{item.quoted ? '已提交报价，可查看记录' : '点击查看规格并报价'}}</text>
        <text class="link-text">查看 ›</text>
      </view>
    </view>
  </block>
</view>
