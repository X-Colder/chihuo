.hero-card {
  margin-bottom: 20rpx;
  padding: 30rpx 26rpx;
  border-radius: 14rpx;
  background: #1f6b57;
  color: #ffffff;
}

.hero-card .eyebrow,
.hero-card .hero-note {
  color: #dceee3;
}

.hero-card .status {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-note {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0ed;
}

.detail-row:last-of-type {
  border-bottom: 0;
}

.hint {
  display: block;
  margin-top: 18rpx;
  color: #7d8b84;
  font-size: 23rpx;
  line-height: 1.5;
}

.action-card .section-title {
  margin-top: 0;
}

.action-card button {
  margin-top: 24rpx;
}
