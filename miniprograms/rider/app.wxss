page {
  background: #f5f7f4;
  color: #183333;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  border: 0;
  border-radius: 0;
  margin: 0;
  padding: 0;
  line-height: 1.4;
}

button::after {
  border: 0;
}

text {
  display: inline-block;
}
