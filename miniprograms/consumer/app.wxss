page {
  background: #f5f7f2;
  color: #1d2d27;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #1f6b57;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.page-title {
  display: block;
  margin-top: 10rpx;
  color: #182a23;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #718078;
  font-size: 25rpx;
  line-height: 1.55;
}

.primary-btn {
  background: #1f6b57;
  color: #ffffff;
}

.secondary-btn {
  background: #e4eee8;
  color: #1f6b57;
}

.ghost-btn {
  min-width: 0;
  padding: 0 24rpx;
  background: transparent;
  color: #1f6b57;
  line-height: 64rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #e5ebe6;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(37, 67, 53, 0.05);
}

.card-title {
  color: #1d2d27;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.4;
}

.muted {
  color: #7d8b84;
  font-size: 24rpx;
}

.section-title {
  display: block;
  margin: 34rpx 0 18rpx;
  color: #24352d;
  font-size: 30rpx;
  font-weight: 700;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  margin: 0 12rpx 10rpx 0;
  padding: 7rpx 14rpx;
  border-radius: 8rpx;
  background: #edf5ef;
  color: #36725e;
  font-size: 22rpx;
}

.status {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #fff4df;
  color: #a56b20;
  font-size: 22rpx;
}

.status.success {
  background: #e4f3e8;
  color: #26704d;
}

.status.muted-status {
  background: #eef1f0;
  color: #718078;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.meta {
  margin-right: 24rpx;
  color: #5f6f67;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty,
.error {
  padding: 76rpx 24rpx;
  text-align: center;
  color: #7d8b84;
}

.error {
  color: #a5534b;
}

.loading {
  padding: 60rpx;
  text-align: center;
  color: #718078;
}

.form-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #314239;
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker {
  width: 100%;
  padding: 22rpx;
  border: 1rpx solid #dfe8e1;
  border-radius: 10rpx;
  background: #fbfcfa;
  color: #1d2d27;
}

.textarea {
  min-height: 150rpx;
  line-height: 1.55;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-row .form-card,
.form-row .field {
  flex: 1;
}

.field {
  margin-bottom: 22rpx;
}

.bottom-action {
  margin-top: 28rpx;
  padding-bottom: 24rpx;
}

.hint {
  margin-top: 14rpx;
  color: #7d8b84;
  font-size: 23rpx;
  line-height: 1.55;
}

.divider {
  height: 1rpx;
  margin: 22rpx 0;
  background: #edf0ed;
}

.amount {
  color: #bd613e;
  font-size: 34rpx;
  font-weight: 700;
}
