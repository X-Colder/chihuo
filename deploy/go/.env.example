# Go source directory used by deploy/go/Dockerfile.
GO_API_DIR=backend-go
GO_VERSION=1.24

# Replace the image when using a registry or CI-built artifact.
API_IMAGE=chihuo-go-api:local
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=chihuo
POSTGRES_USER=chihuo
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgres://chihuo:local-only-change-me@postgres:5432/chihuo

JWT_SECRET=local-only-change-me-change-this-secret-32-bytes
JWT_ISSUER=chihuo-api
JWT_TTL=168h
DEV_LOGIN_ENABLED=false
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Leave empty to disable Redis. Set this when starting the redis profile.
REDIS_ENABLED=false
REDIS_URL=
REDIS_DB=0
REDIS_PASSWORD=
